AMC_PERIOD=2026-05
AMC_OUTPUT_DIR=data/raw
AMC_DOWNLOAD=true
AMC_MAX_FILES=0
AMC_DELAY_SECONDS=0
AMC_CONNECT_TIMEOUT=30
AMC_READ_TIMEOUT=120
AMC_DISCOVERY_TIMEOUT=30
AMC_RETRY_TOTAL=2
AMC_RETRY_BACKOFF=0.5
AMC_PROCESS_TIMEOUT=600
AMC_BROWSER_HEADLESS=true

# Browser-only adapters use these defaults unless overridden here.
HDFC_PAGE_URL=https://www.hdfcfund.com/statutory-disclosure/portfolio/monthly-portfolio
BANDHAN_PAGE_URL=https://bandhanmutual.com/statutory-disclosures/scheme-portfolios/monthly-half-yearly
JM_PAGE_URL=https://www.jmfinancialmf.com/downloads/Portfolio-Disclosure

# Quantum publishes its monthly portfolio at a single opaque, un-dated URL, so
# the script refuses to guess and requires this to be re-verified by hand
# every month: open the file, confirm its "As on <date>" text, then set this.
# QUANTUM_LATEST_PERIOD=2026-07
